# GatherWise AI — Environment Variables Example
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# ---------------------------------------------------------------------------
# Google Gemini API (Phase 3 Integration)
# ---------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# Keep this secret; it is accessed strictly server-side in API routes.
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Default Gemini model override (defaults to gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# Application Configuration
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="GatherWise AI"
NEXT_PUBLIC_APP_URL=http://localhost:3000
